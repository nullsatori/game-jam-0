* text=auto

# Every binary file goes through Git LFS (owner's decision 2026-10-16).
# Rules and setup: Docs/Development.md, "Git LFS". Scripts/check_lfs.sh (CI)
# fails on a binary file stored outside LFS, so a new binary type goes here.
# Art sources (.blend, .psd, ...) are not committed at all: see .gitignore.

# Unreal assets. They cannot be merged, so they are lockable:
# `git lfs lock <path>` before editing.
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap filter=lfs diff=lfs merge=lfs -text lockable
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text

# Meshes and scenes for import

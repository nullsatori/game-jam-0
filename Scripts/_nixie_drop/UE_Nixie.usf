// Nixie v6. Inlined by build_ue_nixie.py into a UE Material Custom node.
// numpy mirror for offline previews: preview_nixie.py (keep the two in step).
//
// One opaque face hides a whole gas-discharge tube behind its glass:
//   z = 0                 glass (clearcoat, Fresnel, lit dust, inner echo)
//   z = Depth * .45       hexagonal anode mesh (dark, silhouettes the glow)
//   z = Depth + k*Spacing ten cathodes, k = stack rank (ИН-14 order 1 6 2 7 5 0 4 9 8 3)
//   behind the stack      back anode plate (BackColor texture)
// Every layer is found by marching the eye ray through the face plane, so the
// lit digit sits at its own depth and the front wires cross its glow.
//
// Atlas RGBA (T_Jam_Nixie_Distance): R signed edge distance, G wire-local
// irradiance, B wire radius, A distance along the wire from the lead.
// Time: everything animated is a function of (TimeSeconds - an event time) or
// of TimeSeconds itself, so it looks the same at any frame rate. The component
// writes ChangeTime / PowerTime once per event; nothing ticks.
// v6 (owner 22.10, "the change is dull"): the clocks are slow enough to see at a 75 px
// face in HIP - the discharge crawls up the new cathode over IgniteSeconds, the old one
// cools from orange through red over AfterglowSeconds, the strike runs hot for most of
// the ignition, and the gas round the new digit flashes at the change so it reads at any size.
struct NixieV5 {
    float Hash(float3 p) {
        p=frac(p*.1031); p+=dot(p,p.yzx+33.33);
        return frac((p.x+p.y)*p.z);
    }
    float Noise(float3 p) {
        float3 c=floor(p), t=frac(p); t=t*t*(3.0-2.0*t);
        float a=lerp(lerp(Hash(c),Hash(c+float3(1,0,0)),t.x),lerp(Hash(c+float3(0,1,0)),Hash(c+float3(1,1,0)),t.x),t.y);
        float b=lerp(lerp(Hash(c+float3(0,0,1)),Hash(c+float3(1,0,1)),t.x),lerp(Hash(c+float3(0,1,1)),Hash(c+float3(1,1,1)),t.x),t.y);
        return lerp(a,b,t.z);
    }
    float2 AtlasUV(float index, float2 uv) {
        float2 cell=float2(fmod(index,4.0),floor(index/4.0));
        return (cell*256.0+16.5+saturate(uv)*223.0)/1024.0;
    }
    // One cathode sample. Outside its cell or for blank/reserved digits: far away, unlit.
    float4 Cell(Texture2D Atlas, SamplerState S, float index, float2 uv) {
        float inside=step(0.0,uv.x)*step(uv.x,1.0)*step(0.0,uv.y)*step(uv.y,1.0)*step(index,9.5);
        float4 e=Texture2DSampleLevel(Atlas,S,AtlasUV(index,uv),0);
        return lerp(float4(1,0,0,0),e,inside);
    }
    // Area coverage of a thin wire over a footprint of half-width aa (no smoothstep peak).
    float Coverage(float4 e, float aa, float minRadius) {
        float d=(e.r-.5)*16.0, r=e.b*2.0;
        float c=max(d+r,0.0);
        float dr=max(r,minRadius);
        aa=max(aa,.025);
        return saturate((dr+aa-c)/(2.0*aa))-saturate((-dr+aa-c)/(2.0*aa));
    }
    // Lit cathode: four sub-pixel footprints so thin diagonals do not bead in ADS.
    float ActiveCore(Texture2D Atlas, SamplerState S, float index, float2 uv, float2 dx, float2 dy, float pixelSpan, float minPixels) {
        float sum=0.0;
        [unroll] for(int tap=0;tap<4;tap++) {
            float2 o=(tap<2?-dx:dx)+((tap%2)==0?-dy:dy);
            sum+=Coverage(Cell(Atlas,S,index,uv+o),pixelSpan*.25,pixelSpan*clamp(minPixels,0.0,1.2)*.5);
        }
        return sum*.25;
    }
    // Distance to the nearest edge of a hexagonal cell, in cells (flat-to-flat = 1).
    float HexEdge(float2 p) {
        const float2 s=float2(1.0,1.7320508);
        float2 a=p-s*floor(p/s)-s*.5;
        float2 q=p-s*.5; float2 b=q-s*floor(q/s)-s*.5;
        float2 g=dot(a,a)<dot(b,b)?a:b;
        return .5-max(dot(abs(g),s*.5),abs(g.x));
    }
    // A layer z cm behind the glass, seen along this pixel's ray.
    float2 Layer(float2 uv, float2 rayUV, float z) { return uv-clamp(rayUV*z,-.3,.3); }
    // Power-on: the tube strikes, drops out, restrikes, then settles with a small overshoot.
    float Warmup(float t, float w) {
        if (w<=0.0) return 1.0;
        float x=t/w;
        float g=x<.12?.70:x<.25?.04:x<.40?.95:x<.50?.22:1.0+.30*exp(-(x-.5)*7.0);
        return x>=4.0?1.0:g;
    }
};
NixieV5 nx;
float digit=clamp(floor(Digit+.5),0.0,10.0);
float prevDigit=clamp(floor(PrevDigit+.5),0.0,10.0);
float now=TimeSeconds;

// ---- View ray in the face's own frame (cm); respects mesh rotation and UV V.
float3 dpX=ddx(WorldPos), dpY=ddy(WorldPos);
float2 duX=ddx(UV), duY=ddy(UV);
float det=duX.x*duY.y-duX.y*duY.x;
float safeDet=(det<0.0?-1.0:1.0)*max(abs(det),1e-12);
float3 tangentU=normalize((dpX*duY.y-dpY*duX.y)/safeDet);
float3 tangentV=normalize((dpY*duX.x-dpX*duY.x)/safeDet);
float3 planeN=normalize(cross(tangentU,tangentV));
float3 eye=normalize(CameraVector);
float cosView=abs(dot(eye,planeN));
float facing=max(cosView,.3);
float2 size=float2(max(WidthCm,.01),max(HeightCm,.01));
float2 rayUV=float2(dot(eye,tangentU),dot(eye,tangentV))/facing/size;    // uv shift per cm of depth
float depth0=max(DepthCm,0.0), spacing=max(StackSpacingCm,0.0);

float2 dx=ddx(UV)*.25, dy=ddy(UV)*.25;
float pixelSpan=max(max(length(ddx(UV)*223.0),length(ddy(UV)*223.0)),.05);

// ---- Event clocks (component stamps; defaults far in the past = steady state).
float tChange=max(now-ChangeTime,0.0);
float tPower=max(now-PowerTime,0.0);
float on=saturate(Enabled);
float power=on>0.5?nx.Warmup(tPower,WarmupSeconds)
    :exp(-tPower/max(AfterglowSeconds,.001))*step(tPower,max(AfterglowSeconds,.001)*8.0);
float ignite=IgniteSeconds>0.0?saturate(tChange/IgniteSeconds):1.0;
ignite=1.0-pow(1.0-ignite,1.8);                                                          // quick off the lead, slow at the end: a 0's slash opens last
float strike=1.0+max(StrikeOvershoot,0.0)*exp(-tChange/max(IgniteSeconds*.6,.08));   // hot for most of the ignition
float changed=step(.5,abs(prevDigit-digit))*step(prevDigit,9.5);
float blink=max(StrikeOvershoot,0.0)*.12*exp(-tChange/.05)*changed;                    // a breath of gas round the new digit, faint: the crawl must show (owner 22.10)
// A lit 0 blinks at EmptyBlinkHz once it has ignited (the empty magazine); 0 Hz: steady, as on a world prop.
float empty=step(abs(digit),.5)*step(.01,EmptyBlinkHz)*step(IgniteSeconds+.25,tChange);
float phase=frac(now*max(EmptyBlinkHz,.01));
float pulse=smoothstep(0.0,.06,phase)*(1.0-smoothstep(.52,.62,phase));
float emptyGain=lerp(1.0,lerp(.10,1.0,pulse),empty);                                    // dips to a faint gas, never fully dark
float emptyStrike=1.0+.5*exp(-phase/.04)*empty;                                         // each re-strike runs hot for a moment
float cool=saturate(tChange/max(AfterglowSeconds,.001));                                 // 0 just switched off .. 1 cold
float prevFade=pow(1.0-cool,3.0)*changed;                                               // a wire cooling: gone quickly (owner 22.10: a long one read as ghosting)
float3 prevColor=lerp(float3(1.0,.30,.05),float3(1.0,.06,.004),saturate(cool*1.6));     // orange through red to dark

// ---- Stack rank of the lit and the previous digit (front 0 .. back 9).
const float order[10]={1,6,2,7,5,0,4,9,8,3};
float rankLit=0.0, rankPrev=0.0;
[unroll] for(int r=0;r<10;r++) { rankLit+=r*step(abs(order[r]-digit),.5); rankPrev+=r*step(abs(order[r]-prevDigit),.5); }
float zLit=depth0+rankLit*spacing;
float2 litUV=nx.Layer(UV,rayUV,zLit);

// ---- Lit cathode: core, its discharge clock and the gas around it.
float4 lit=nx.Cell(Atlas,AtlasSampler,digit,litUV);
float core=nx.ActiveCore(Atlas,AtlasSampler,digit,litUV,dx,dy,pixelSpan,MinCorePixels);
float outside=max((lit.r-.5)*16.0,0.0);
float sheath=exp(-outside*1.75)*(1.0-core*.92);
float halo=exp(-pow(outside/3.25,2.0))*(1.0-core)*(1.0-smoothstep(6.0,8.0,outside));
float arc=lit.a;
float front=ignite*1.12;
float kindled=saturate((front-arc)/.10);                                  // discharge crawls from the lead
float frontFlash=exp(-pow((arc-front)/.05,2.0))*(1.0-ignite)*2.2;        // bright ionisation front
// Discharge patches drift along the wire itself, not across the screen.
float patches=nx.Noise(float3(arc*max(SegmentScale,1.0),litUV.y*3.0,now*max(SegmentRate,0.0)+FlickerPhase));
float wireGain=(1.0+clamp(SegmentStrength,0.0,.15)*(patches*2.0-1.0))*(kindled+frontFlash);
// Gas volume: the same glow seen at three depths around the lit cathode.
float volSpread=max(spacing,.02)*1.5;
float gasFront=nx.Cell(Atlas,AtlasSampler,digit,nx.Layer(UV,rayUV,max(zLit-volSpread,0.0))).g;
float gasBack=nx.Cell(Atlas,AtlasSampler,digit,nx.Layer(UV,rayUV,zLit+volSpread)).g;
float volumeFull=(gasFront+lit.g+gasBack)/3.0;
float volume=volumeFull*ignite;

// ---- March the stack front to back: dark metal wires, glow they catch, and
// the shadows the front ones throw across the lit digit.
float meshZ=depth0*.45;
float2 meshP=nx.Layer(UV,rayUV,meshZ)*size/max(MeshCellCm,.01);
float meshFw=max(max(fwidth(meshP.x),fwidth(meshP.y)),1e-4);
float meshHalf=max(MeshWireCm,0.0)/max(MeshCellCm,.01)*.5;
float meshSharp=saturate((meshHalf+meshFw*.5-nx.HexEdge(meshP))/meshFw);
float meshCov=lerp(saturate(4.0*meshHalf),meshSharp,1.0-smoothstep(.15,.40,meshFw)); // sub-pixel mesh → its mean
float transmit=1.0-meshCov*saturate(MeshOpacity);     // light that passes the mesh toward the eye
float metal=meshCov*max(GhostStrength,0.0)*.9;        // front-lit mesh albedo
float throughFront=1.0;                               // what the cathodes in front leave of a layer
float litShadow=1.0, prevShadow=1.0, bounce=0.0, prevCore=0.0;
[unroll] for(int k=0;k<10;k++) {
    float z=depth0+k*spacing;
    float isLit=step(abs(order[k]-digit),.5);
    float isPrev=step(abs(order[k]-prevDigit),.5);
    float cov=nx.Coverage(nx.Cell(Atlas,AtlasSampler,order[k],nx.Layer(UV,rayUV,z)),pixelSpan*.5,0.0);
    litShadow=lerp(litShadow,throughFront,isLit);
    prevShadow=lerp(prevShadow,throughFront,isPrev);
    prevCore+=cov*isPrev;
    float nearGain=exp(-abs(z-zLit)/max(spacing*2.5,.02));        // neighbours catch most of the glow
    bounce+=(1.0-isLit)*throughFront*cov*nearGain*volume;
    metal+=(1.0-isLit)*throughFront*cov*max(GhostStrength,0.0)*(1.0-meshCov);
    throughFront*=1.0-(1.0-isLit)*cov*saturate(CathodeShadow);
}
// The lit wire is metal too when the tube is off.
metal+=(1.0-step(.5,on*power))*litShadow*core*max(GhostStrength,0.0)*(1.0-meshCov);

// ---- Back anode plate, a little behind the last cathode.
float zBack=depth0+10.5*spacing;
float2 backUV=saturate(nx.Layer(UV,rayUV,zBack));
float3 front3=Texture2DSample(BackColor,BackColorSampler,UV).rgb;
float3 back=Texture2DSample(BackColor,BackColorSampler,backUV).rgb;
float bakedGhost=Texture2DSample(Masks,MasksSampler,backUV).g;
// The legacy plate has static wire drawings; the real stack above replaces them.
float3 encodedBack=lerp(back*12.92,1.055*pow(max(back,0.0),1.0/2.4)-.055,step(.0031308,back));
encodedBack=max(encodedBack-bakedGhost*float3(.083,.086,.067),0.0);
back=lerp(encodedBack/12.92,pow((encodedBack+.055)/1.055,2.4),step(.04045,encodedBack));
float plateField=nx.Cell(Atlas,AtlasSampler,digit,backUV).g*ignite;

float3 glass=Texture2DSample(Masks,MasksSampler,UV).rgb;    // aperture, legacy ghost, dirt
float aperture=glass.r;
LayeredBaseColor=lerp(front3,back*.72*throughFront*(1.0-meshCov),aperture)+aperture*metal*float3(.78,.74,.68);

// ---- Emission. Glass passes 1-F of the inner light (Schlick, n=1.5).
float fresnel=.04+.96*pow(1.0-cosView,5.0);
float flicker=1.0+clamp(FlickerStrength,0.0,.05)*(.65*sin(now*57.3)+.35*sin(now*93.7));
float3 hot=lerp(CoreColor,float3(1.0,.46,.13),saturate((strike*emptyStrike-1.0)*1.2));    // strike runs hotter
float3 wire=(core*max(CoreIntensity,0.0)*hot
    +sheath*max(DischargeIntensity,0.0)*DischargeColor
    +halo*max(HaloIntensity,0.0)*HaloColor)*wireGain*strike*litShadow;
float3 gas=max(InternalRadiance,0.0)*(volume*.35+volumeFull*blink*.5)*DischargeColor*lerp(1.0,litShadow,.5);
float3 caught=max(CathodeBounce,0.0)*bounce*(DischargeColor+.25*CoreColor)
    +max(MeshGlow,0.0)*meshCov*volume*DischargeColor;
float3 plate=max(InternalRadiance,0.0)*plateField*.12*throughFront*DischargeColor;
float2 echoUV=UV-clamp(rayUV*zLit*.35,-.3,.3)+float2(.006,-.004);
float echo=nx.Coverage(nx.Cell(Atlas,AtlasSampler,digit,echoUV),pixelSpan*.5,0.0)*(1.0-core);
float innerRim=exp(-pow((abs(UV.x-.5)-.365)/.035,2.0))*volume*.12;
float3 optics=max(GlassEchoStrength,0.0)*echo*ignite*DischargeColor
    +max(EdgeRadiance,0.0)*innerRim*DischargeColor
    +max(DustScatter,0.0)*glass.b*volume*DischargeColor;                  // dust on the glass lit from inside
float3 afterglow=prevCore*prevShadow*prevFade*on*max(CoreIntensity,0.0)*.55*prevColor;
float3 tube=(wire*emptyStrike+gas+caught+plate)*transmit*power*emptyGain+afterglow*transmit;
return aperture*(1.0-fresnel)*flicker*(tube+optics*power*emptyGain);

// v11 stage 5 (Docs/RecoilWeapons-SmokeV11.md): the gas drawn once per screen block, not once per pixel.
// MainBlockCS marches the block centre's ray (the same ray M_OS_GasPost gave every pixel of the block) through every
// cloud, to the block's farthest scene depth, and flags a block whose depths differ (a gun's edge, a wall's rim);
// MainCompositePS takes the block's result, or marches its own pixel's depth in a flagged block (crisp edges).
// The march is M_OS_GasPost's (Scripts/os_muzzle_fx.py, GAS_POST_HLSL), kept the same: two atlases per cloud blended
// by the step's phase, soft tunnels, the eye's and the box faces' fades, the 4 bands; its light is the material's under
// os.Gas.Light 0 and stage 6's under os.Gas.Light 1 (the room's light from the frame, the key lamp's full colour).

#include "/Engine/Private/Common.ush"

Texture2D SceneDepth;
Texture2D<float4> GasData;
Texture2D<float4> GasTunnels;
Texture2D GasGrid0;
Texture2D GasGrid1;
Texture2D GasGrid2;
Texture2D GasGrid3;
Texture2D GasGrid4;
Texture2D GasGrid5;
Texture2D GasGrid6;
Texture2D GasGrid7;
Texture2D GasGrid8;
Texture2D GasGrid9;
// The zones' haze (v12 7a): slots 10 and 11.
Texture2D GasGrid10;
Texture2D GasGrid11;
SamplerState GasSampler;
// The composite (v12 7a.6): 1 an ordered 4x4 Bayer threshold over the blocks and the tail from 0.03, 0 a hash; levels.
float GasDither;
float GasBands;
float GasCloudCount;
float GasTunnelCount;
float GasBlockPx;
float GasEyeClear;
float GasDebugAlpha;
float3 GasCamera;
// Stage 6 (os.Gas.Light 1): the room's light from the frame (GasAmbient, the scene before the gas, 1/32 and blurred),
// a darker albedo, the key lamp's full colour. 0: the light as before (the map's ambient constants, base x1.5).
float GasLight;
float GasAmbientScale;
float GasLightScale;
float GasAlbedo;
Texture2D GasAmbient;
SamplerState GasAmbientSampler;
// Stage 6b: the lamps' light in scene units x the frame's exposure (View.PreExposure: the last frame's eye adaptation -
// the adaptation buffer is the renderer's own; a frame late on a jump), through the scene's film curve (its parameters).
float GasForward;
float GasFilmSlope;
float GasFilmToe;
float GasFilmShoulder;
float GasFilmBlackClip;
float GasFilmWhiteClip;

// UE's filmic curve (TonemapCommon.ush FilmToneMap) in linear sRGB, not ACEScg, without the grading LUT (deviation):
// the lamps' light on the gas reaches the screen as it reaches the walls.
float3 GasFilm(float3 x)
{
	const float3 Y = float3(0.2126, 0.7152, 0.0722);
	x = max(lerp(dot(x, Y), x, 0.96), 1e-10);
	float ToeScale = 1 + GasFilmBlackClip - GasFilmToe;
	float ShoulderScale = 1 + GasFilmWhiteClip - GasFilmShoulder;
	float InMatch = 0.18, OutMatch = 0.18;
	float ToeMatch;
	if (GasFilmToe > 0.8)
	{
		ToeMatch = (1 - GasFilmToe - OutMatch) / GasFilmSlope + log10(InMatch);
	}
	else
	{
		float bt = (OutMatch + GasFilmBlackClip) / ToeScale - 1;
		ToeMatch = log10(InMatch) - 0.5 * log((1 + bt) / (1 - bt)) * (ToeScale / GasFilmSlope);
	}
	float StraightMatch = (1 - GasFilmToe) / GasFilmSlope - ToeMatch;
	float ShoulderMatch = GasFilmShoulder / GasFilmSlope - StraightMatch;
	float3 LogColor = log10(x);
	float3 StraightColor = GasFilmSlope * (LogColor + StraightMatch);
	float3 ToeColor = (-GasFilmBlackClip) + (2 * ToeScale) / (1 + exp((-2 * GasFilmSlope / ToeScale) * (LogColor - ToeMatch)));
	float3 ShoulderColor = (1 + GasFilmWhiteClip) - (2 * ShoulderScale) / (1 + exp((2 * GasFilmSlope / ShoulderScale) * (LogColor - ShoulderMatch)));
	ToeColor = select(LogColor < ToeMatch, ToeColor, StraightColor);
	ShoulderColor = select(LogColor > ShoulderMatch, ShoulderColor, StraightColor);
	float3 t = saturate((LogColor - ToeMatch) / (ShoulderMatch - ToeMatch));
	t = ShoulderMatch < ToeMatch ? 1 - t : t;
	t = (3 - 2 * t) * t * t;
	float3 Tone = lerp(ToeColor, ShoulderColor, t);
	return max(0, lerp(dot(Tone, Y), Tone, 0.93));
}

float3 GasToLinear(float3 c)
{
	return select(c <= 0.04045, c / 12.92, pow((max(c, 0) + 0.055) / 1.055, 2.4));
}

float3 GasToSrgb(float3 c)
{
	c = max(c, 0);
	return select(c <= 0.0031308, c * 12.92, 1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

// The four lamps' light scattered at pw toward the eye (scene units): UE's falloff (inverse square windowed by the
// radius, or (1 - d^2/R^2)^exponent), a spot's cone (smoothstep of the cosines), Henyey-Greenstein g 0.55 with
// 1 - GasForward isotropic (1 = isotropic's level), the key's baked self-shadow, the others' ambient occlusion.
// The cloud's lamps are loaded once a cloud (LA position + radius, LL light + exponent, LC cone, LD cos inner + key);
// nl > 0: any lit.
float3 GasLamps(int nl, float4 LA[4], float4 LL[4], float4 LC[4], float4 LD[4], float3 pw, float3 dir, float4 v, float g, float T)
{
	float3 Sum = 0;
	[unroll] for (int k = 0; k < 4; k++)
	{
		float4 A = LA[k], L = LL[k], Cone = LC[k], D = LD[k];
		if (L.r + L.g + L.b <= 0.0) continue;
		float3 Ld = A.xyz;
		float Att = 1.0;
		if (A.w > 0.0)
		{
			float3 V = A.xyz - pw;
			float D2 = dot(V, V);
			Ld = V * rsqrt(max(D2, 1.0));
			float R2 = A.w * A.w;
			Att = L.w > 0.0 ? pow(1.0 - saturate(D2 / R2), L.w) : Square(saturate(1.0 - Square(D2 / R2))) / (D2 + 1.0);
			Att *= Cone.w > -1.5 ? smoothstep(Cone.w, D.x, dot(-Ld, Cone.xyz)) : 1.0;
		}
		// The scattering angle: the light's way (-Ld) against the way to the eye (-dir).
		float CosT = dot(Ld, dir);
		float HG = (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * CosT, 1e-4), 1.5);
		float Phase = (1.0 - GasForward) + GasForward * HG;
		// The key: its baked self-shadow; the player's own lamp (by the eye): the march's transmittance so far - the near
		// face lit, the depth dark (v12, a review's point); the others the ambient occlusion.
		float Shadow = D.y > 0.5 ? v.b : D.z > 0.5 ? T : 0.35 + 0.65 * v.a;
		Sum += L.rgb * (Att * Phase * Shadow);
	}
	return Sum;
}
// The output's rect (post-upscale pixels) and the depth's (render pixels): a pixel's depth texel is
// DepthMin + (Px - OutMin) * DepthScale.
int2 OutMin;
int2 OutSize;
int2 DepthMin;
float2 DepthScale;

// Where an output pixel's ray meets the scene (distance from the eye, cm) and its direction, from the render view.
float3 PixelRay(float2 OutPx, out float SceneDist)
{
	float2 DepthPx = DepthMin + (OutPx - OutMin) * DepthScale;
	float DeviceZ = SceneDepth.Load(int3(DepthPx, 0)).r;
	float4 Far = mul(float4(DepthPx, 0.5, 1), View.SVPositionToTranslatedWorld);
	float3 Dir = normalize(Far.xyz / Far.w - View.TranslatedWorldCameraOrigin);
	if (DeviceZ <= 0.0)
	{
		SceneDist = 1e7;
	}
	else
	{
		float4 Hit = mul(float4(DepthPx, DeviceZ, 1), View.SVPositionToTranslatedWorld);
		SceneDist = length(Hit.xyz / Hit.w - View.TranslatedWorldCameraOrigin);
	}
	return Dir;
}

float3 RayDir(float2 OutPx)
{
	float Unused;
	return PixelRay(OutPx, Unused);
}

// bLamps false: the lamps left out (an edge pixel takes its block's); lampAcc the lamps' filmed light, premultiplied.
void GasMarch(float3 Cam, float3 dir, float sceneDist, float jit, float3 room, bool bLamps, out float3 acc, out float T, out float firstT, out float3 lampAcc)
{
	firstT = 1e9;
	// The tunnels this ray crosses: (t of the closest approach, its distance, sin of the angle, radius), the stretch
	// inside the caps, the birth.
	float4 hq[16];
	float2 hc[16];
	float hb[16];
	int nh = 0;
	int nt = (int)(GasTunnelCount + 0.5);
	[loop] for (int k = 0; k < nt && nh < 16; k++)
	{
	    float4 ta = GasTunnels.Load(int3(k, 0, 0));
	    float4 tb = GasTunnels.Load(int3(k, 1, 0));
	    float birth = GasTunnels.Load(int3(k, 2, 0)).x;
	    float r = ta.w * (1.0 - 0.5 * tb.w);
	    if (r < 0.3) continue;
	    float3 u = tb.xyz - ta.xyz;
	    float L = length(u);
	    if (L < 1e-3) continue;
	    float3 ax = u / L;
	    float3 m = Cam - ta.xyz;
	    float da = dot(dir, ax), ma = dot(m, ax);
	    float3 dp = dir - ax * da, mp = m - ax * ma;
	    float A = dot(dp, dp);
	    float tc = A > 1e-6 ? -dot(dp, mp) / A : 0.0;
	    float dmin = length(mp + dp * tc);
	    if (dmin >= r) continue;
	    float2 caps = float2(-1e9, 1e9);
	    if (abs(da) > 1e-6)
	    {
	        float c0 = (0.0 - ma) / da, c1 = (L - ma) / da;
	        caps = float2(min(c0, c1), max(c0, c1));
	    }
	    else if (ma < 0 || ma > L) continue;
	    // Only the stretch of the ray inside the cylinder is checked per sample (it was the caps' whole span).
	    float hw = sqrt(r * r - dmin * dmin) / max(sqrt(A), 0.05);
	    hq[nh] = float4(tc, dmin, sqrt(A), r);
	    hc[nh] = float2(max(caps.x, tc - hw), min(caps.y, tc + hw));
	    hb[nh] = birth;
	    nh++;
	}
	T = 1.0;
	acc = 0;
	float3 accL = 0;
	int nc = (int)(GasCloudCount + 0.5);
	float3 inv = 1.0 / dir;
	[loop] for (int c = 0; c < nc; c++)
	{
	    float4 d0 = GasData.Load(int3(c, 0, 0));
	    float4 d1 = GasData.Load(int3(c, 1, 0));
	    float4 d2 = GasData.Load(int3(c, 2, 0));
	    float4 d3 = GasData.Load(int3(c, 3, 0));
	    float4 d4 = GasData.Load(int3(c, 4, 0));
	    float4 d7 = GasData.Load(int3(c, 7, 0));
	    float4 d8 = GasData.Load(int3(c, 8, 0));
	    float cellP = d8.x;
	    // os.Gas.Light 1: the room's light x, the lamps' g, the samples at most (the haze: 0.5, 0.55 -> 0.3, 32).
	    float ambMul = d8.y > 0.0 ? d8.y : 1.0;
	    float hg = d8.z > 0.0 ? d8.z : 0.55;
	    int maxS = d8.w > 0.0 ? (int)d8.w : 96;
	    float3 C = d0.xyz;
	    float H = d0.w;
	    float n = d1.x, cell = d1.y, gain = d1.z, ext = d1.w;
	    float phase = d2.w;
	    float cloudBirth = d3.w;
	    float curHalf = d4.w;
	    float3 CP = d7.xyz;
	    float HP = d7.w;
	    if (gain <= 0.0 || H <= 0.0) continue;
	    float3 key = d2.rgb;
	    float3 base = d3.rgb;
	    float3 warm = d4.rgb;
	    float3 top = GasData.Load(int3(c, 5, 0)).rgb;
	    float3 bot = GasData.Load(int3(c, 6, 0)).rgb;
	    // Where both atlases hold gas (rows 9-12, the cells they wrote): the march over their union, not the boxes.
	    float3 qa0 = GasData.Load(int3(c, 9, 0)).xyz, qa1 = GasData.Load(int3(c, 10, 0)).xyz;
	    float3 qb0 = GasData.Load(int3(c, 11, 0)).xyz, qb1 = GasData.Load(int3(c, 12, 0)).xyz;
	    float3 t0 = (qa0 - Cam) * inv, t1 = (qa1 - Cam) * inv;
	    float3 tn = min(t0, t1), tf = max(t0, t1);
	    float aC = max(max(tn.x, tn.y), tn.z), bC = min(min(tf.x, tf.y), tf.z);
	    float3 p0 = (qb0 - Cam) * inv, p1 = (qb1 - Cam) * inv;
	    float3 pn = min(p0, p1), pf = max(p0, p1);
	    float aP = max(max(pn.x, pn.y), pn.z), bP = min(min(pf.x, pf.y), pf.z);
	    float a = max(min(bC > aC ? aC : 1e9, bP > aP ? aP : 1e9), GasEyeClear * 0.5);
	    float b = min(max(bC > aC ? bC : -1e9, bP > aP ? bP : -1e9), sceneDist);
	    if (b <= a) continue;
	    // Coarse cells (a vacuum cone metres long) at 1.5 cells a step: the jitter hides it, a third fewer samples.
	    float stepCm = max(min(cell, cellP), 1.5) * (min(cell, cellP) >= 4.0 ? 1.5 : 1.0);
	    // 96 samples a cloud at most (a doubled step through thin gas lost half the thin smoke: not taken).
	    int ns = min((int)((b - a) / stepCm) + 1, maxS);
	    float t = a + jit * stepCm;
	    float adv = 0.0;
	    float rows = ceil(n / 8.0) * n;
	    float2 atlas = float2(8.0 * n, 2.0 * rows);
	    float vC0 = curHalf * rows, vP0 = (1.0 - curHalf) * rows;
	    // os.Gas.Light 1: the cloud's lit lamps, once (not per sample).
	    // Static indices only (a dynamically indexed array went to scratch memory).
	    float4 LA[4], LL[4], LC[4], LD[4];
	    int nl = 0;
	    [unroll] for (int k = 0; k < 4; k++)
	    {
	        LL[k] = GasLight > 0.5 && bLamps ? GasData.Load(int3(c, 14 + 4 * k, 0)) : 0;
	        LA[k] = GasData.Load(int3(c, 13 + 4 * k, 0));
	        LC[k] = GasData.Load(int3(c, 15 + 4 * k, 0));
	        LD[k] = GasData.Load(int3(c, 16 + 4 * k, 0));
	        nl += LL[k].r + LL[k].g + LL[k].b > 0.0 ? 1 : 0;
	    }
	    [loop] for (int s = 0; s < ns; s++)
	    {
	        t += adv;
	        if (t > b) break;
	        adv = stepCm;
	        // Soft tunnels: the density scaled down within 0.6 r of a tunnel's axis, 0 on it.
	        float keep = 1.0;
	        for (int q = 0; q < nh; q++)
	        {
	            if (cloudBirth < hb[q] && t > hc[q].x && t < hc[q].y)
	            {
	                float dd = sqrt(hq[q].y * hq[q].y + (t - hq[q].x) * (t - hq[q].x) * hq[q].z * hq[q].z);
	                keep *= smoothstep(0.6 * hq[q].w, hq[q].w, dd);
	            }
	        }
	        if (keep < 0.01) continue;
	        float3 pw = Cam + dir * t;
	        float4 vC = 0, vP = 0;
	        float3 p = pw - C;
	        bool inC = phase > 0.001 && all(abs(p) < H);
	        float3 pp = pw - CP;
	        bool inP = phase < 0.999 && all(abs(pp) < HP);
	        float2 uA0 = 0, uA1 = 0, uB0 = 0, uB1 = 0;
	        float fA = 0, fB = 0;
	        if (inC)
	        {
	            float3 g = clamp((p + H) / cell - 0.5, 0.0, n - 1.001);
	            float z0 = floor(g.z);
	            float z1 = min(z0 + 1.0, n - 1.0);
	            float2 xy = clamp(g.xy + 0.5, 0.5, n - 0.5);
	            uA0 = (float2(fmod(z0, 8.0) * n, floor(z0 / 8.0) * n + vC0) + xy) / atlas;
	            uA1 = (float2(fmod(z1, 8.0) * n, floor(z1 / 8.0) * n + vC0) + xy) / atlas;
	            fA = g.z - z0;
	        }
	        if (inP)
	        {
	            float3 g = clamp((pp + HP) / cellP - 0.5, 0.0, n - 1.001);
	            float z0 = floor(g.z);
	            float z1 = min(z0 + 1.0, n - 1.0);
	            float2 xy = clamp(g.xy + 0.5, 0.5, n - 0.5);
	            uB0 = (float2(fmod(z0, 8.0) * n, floor(z0 / 8.0) * n + vP0) + xy) / atlas;
	            uB1 = (float2(fmod(z1, 8.0) * n, floor(z1 / 8.0) * n + vP0) + xy) / atlas;
	            fB = g.z - z0;
	        }
	        float4 sA0 = 0, sA1 = 0, sB0 = 0, sB1 = 0;
	        if (c == 0) { if (inC) { sA0 = GasGrid0.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid0.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid0.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid0.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 1) { if (inC) { sA0 = GasGrid1.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid1.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid1.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid1.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 2) { if (inC) { sA0 = GasGrid2.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid2.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid2.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid2.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 3) { if (inC) { sA0 = GasGrid3.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid3.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid3.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid3.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 4) { if (inC) { sA0 = GasGrid4.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid4.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid4.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid4.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 5) { if (inC) { sA0 = GasGrid5.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid5.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid5.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid5.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 6) { if (inC) { sA0 = GasGrid6.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid6.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid6.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid6.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 7) { if (inC) { sA0 = GasGrid7.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid7.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid7.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid7.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 8) { if (inC) { sA0 = GasGrid8.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid8.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid8.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid8.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 9) { if (inC) { sA0 = GasGrid9.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid9.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid9.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid9.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 10) { if (inC) { sA0 = GasGrid10.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid10.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid10.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid10.SampleLevel(GasSampler, uB1, 0); } }
	        else if (c == 11) { if (inC) { sA0 = GasGrid11.SampleLevel(GasSampler, uA0, 0); sA1 = GasGrid11.SampleLevel(GasSampler, uA1, 0); } if (inP) { sB0 = GasGrid11.SampleLevel(GasSampler, uB0, 0); sB1 = GasGrid11.SampleLevel(GasSampler, uB1, 0); } }
	        // Gas reaching a box's face fades over its last 1.5 cells (a cut face read as a flat soft square).
	        if (inC) vC = lerp(sA0, sA1, fA) * saturate(min(min(H - abs(p.x), H - abs(p.y)), H - abs(p.z)) / (1.5 * cell));
	        if (inP) vP = lerp(sB0, sB1, fB) * saturate(min(min(HP - abs(pp.x), HP - abs(pp.y)), HP - abs(pp.z)) / (1.5 * cellP));
	        float4 v = lerp(vP, vC, phase);
	        float near = smoothstep(GasEyeClear * 0.5, GasEyeClear * 1.5, t);
	        float dens = v.r * gain * keep * near;
	        if (dens < 0.01) continue;
	        float aStep = 1.0 - exp(-ext * dens * stepCm);
	        float3 col;
	        if (GasLight > 0.5)
	        {
	            // Linear display light (the composite encodes it): the room (the graded frame, decoded) by the occlusion;
	            // the lamps' scene light gathered apart and filmed once a ray (below).
	            col = base * GasAlbedo * room * GasAmbientScale * ambMul * (0.35 + 0.65 * v.a) + warm * v.g * v.g;
	            if (nl > 0)
	            {
	                accL += T * aStep * base * GasLamps(nl, LA, LL, LC, LD, pw, dir, v, hg, T);
	            }
	        }
	        else
	        {
	            float3 amb = lerp(bot, top, saturate(0.5 + 0.5 * (pw.z - C.z) / H));
	            col = base * 1.5 * (amb * (0.35 + 0.65 * v.a) + key * v.b) + warm * v.g * v.g;
	        }
	        firstT = min(firstT, t - stepCm);
	        acc += T * aStep * col;
	        T *= 1.0 - aStep;
	        if (T < 0.05) break;
	    }
	}
	// The lamps on the gas (albedo x light x phase / pi, as a grey wall's albedo x light / pi) at the frame's exposure,
	// through the film curve once a ray (the ray's mean lamp light filmed, not each sample: cheaper).
	float alphaL = 1.0 - T;
	lampAcc = 0;
	if (GasLight > 0.5 && alphaL > 1e-4 && any(accL > 0.0))
	{
	    lampAcc = GasFilm(accL / alphaL * (GasAlbedo * GasLightScale * View.PreExposure / PI)) * alphaL;
	}
}

// The room's light round an output pixel (os.Gas.Light 1): the frame before the gas, 1/32 and blurred.
float3 RoomAt(float2 OutPx)
{
	return GasToLinear(GasAmbient.SampleLevel(GasAmbientSampler, (OutPx - OutMin) / max(float2(OutSize), 1.0), 0).rgb);
}

RWTexture2D<float4> OutBlock;
// The block's lamp light (filmed, premultiplied): an edge pixel's own march leaves the lamps out and takes this.
RWTexture2D<float4> OutLamp;
// An edge block's first gas along its ray (cm, a step early), -1 a block taken whole.
RWTexture2D<float> OutEdge;

[numthreads(8, 8, 1)]
void MainBlockCS(uint3 Id : SV_DispatchThreadID)
{
	float B = max(GasBlockPx, 1.0);
	int2 Blocks = int2(ceil(OutSize / B));
	if (any(int2(Id.xy) >= Blocks))
	{
		return;
	}
	// The block in absolute output pixels (as the material's SvPosition: the same blocks, the same hashes).
	float2 Corner = floor(OutMin / B) * B + Id.xy * B;
	float2 Centre = Corner + 0.5 * B;
	float3 dir = RayDir(Centre);
	float Near = 1e9, Far = 0.0;
	for (int y = 0; y < (int)B; y++)
	{
		for (int x = 0; x < (int)B; x++)
		{
			float2 P = clamp(Corner + float2(x, y) + 0.5, OutMin + 0.5, OutMin + OutSize - 0.5);
			float D;
			PixelRay(P, D);
			Near = min(Near, D);
			Far = max(Far, D);
		}
	}
	float jit = frac(sin(dot(floor(Centre / B), float2(12.9898, 78.233))) * 43758.5453);
	float3 acc;
	float T;
	float firstT;
	float3 lampAcc;
	GasMarch(GasCamera, dir, Far, jit, RoomAt(Centre), true, acc, T, firstT, lampAcc);
	OutBlock[Id.xy] = float4(acc + lampAcc, T);
	OutLamp[Id.xy] = float4(lampAcc, 0);
	// An edge: the block's depths differ by more than 3% of the far one or 10 cm, gas in it reached in front of the far
	// depth; its first gas kept (a pixel nearer than that has no gas in front of it).
	bool Edge = Far - Near > max(0.03 * min(Far, 1e5), 10.0) && T < 0.999 && firstT < Far;
	OutEdge[Id.xy] = Edge ? firstT : -1.0;
}

Texture2D SceneColor;
SamplerState SceneColorSampler;
Texture2D<float4> BlockResult;
Texture2D<float> BlockEdge;
Texture2D<float4> BlockLamp;

// The inputs as FScreenPassVS writes them (TEXCOORD0 then SV_POSITION: a pixel shader reading SV_POSITION alone did not
// link with it on D3D12).
void MainCompositePS(noperspective float4 UVAndScreenPos : TEXCOORD0, float4 SvPosition : SV_POSITION, out float4 OutColor : SV_Target0)
{
	float B = max(GasBlockPx, 1.0);
	float2 px = SvPosition.xy;
	int2 Block = int2(floor(px / B) - floor(OutMin / B));
	float4 Col = SceneColor.Load(int3(px, 0));
	float3 acc;
	float T;
	float4 R = BlockResult.Load(int3(Block, 0));
	acc = R.rgb;
	T = R.a;
	float FirstGas = BlockEdge.Load(int3(Block, 0));
	if (FirstGas >= 0.0)
	{
		// An edge block: a pixel nearer than the block's first gas has none in front of it; the others march their own
		// depth (as M_OS_GasPost did in every pixel).
		float D;
		PixelRay(px, D);
		if (D <= FirstGas)
		{
			acc = 0;
			T = 1.0;
		}
		else
		{
			float2 Centre = floor(px / B) * B + 0.5 * B;
			float jit = frac(sin(dot(floor(px / B), float2(12.9898, 78.233))) * 43758.5453);
			float Unused;
			float3 NoLamps;
			GasMarch(GasCamera, RayDir(Centre), D, jit, RoomAt(Centre), false, acc, T, Unused, NoLamps);
			// The block's lamp light, by this pixel's opacity against the block's.
			acc += BlockLamp.Load(int3(Block, 0)).rgb * min((1.0 - T) / max(1.0 - R.a, 1e-3), 2.0);
		}
	}
	float alpha = 1.0 - T;
	// os.Gas.DebugAlpha 4: the room's light the gas takes (os.Gas.Light 1).
	if (GasDebugAlpha > 3.5)
	{
		OutColor = float4(GasToSrgb(RoomAt(px)), 1);
		return;
	}
	// os.Gas.DebugAlpha 3: how far the block's opacity is from the pixel's own march (x4, grey; 0 in a flagged block).
	if (GasDebugAlpha > 2.5)
	{
		float2 Centre = floor(px / B) * B + 0.5 * B;
		float D;
		PixelRay(px, D);
		float3 acc2;
		float T2;
		float Unused2;
		float3 NoLamps2;
		GasMarch(GasCamera, RayDir(Centre), D, frac(sin(dot(floor(px / B), float2(12.9898, 78.233))) * 43758.5453), RoomAt(Centre), false, acc2, T2, Unused2, NoLamps2);
		float Diff = saturate(abs(T2 - T) * 4.0);
		OutColor = float4(Diff, Diff, Diff, 1);
		return;
	}
	float aq;
	if (GasDither > 0.5)
	{
		// An ordered 4x4 Bayer over the screen blocks, the threshold's full spread: thin gas (from 0.03) a sparse even
		// lattice whose mean is its opacity, not snow (v12 7a.6).
		const float Bayer[16] = { 0, 8, 2, 10, 12, 4, 14, 6, 3, 11, 1, 9, 15, 7, 13, 5 };
		int2 Q = int2(floor(px / B)) & 3;
		float hb = (Bayer[Q.y * 4 + Q.x] + 0.5) / 16.0;
		float Levels = max(GasBands, 1.0);
		aq = alpha < 0.03 ? 0.0 : min(floor(alpha * Levels + hb) / Levels, 1.0);
	}
	else
	{
		float hn = frac(sin(dot(floor(px / B), float2(41.3, 289.1))) * 43758.5453);
		// The faint tail off (no snow of lone blocks), the threshold's spread halved: stable bands, few stray blocks.
		aq = alpha < 0.12 ? 0.0 : floor(alpha * 4.0 + 0.25 + 0.5 * hn) / 4.0;
	}
	if (GasDebugAlpha > 0.5)
	{
		OutColor = float4(alpha, alpha, alpha, 1);
		return;
	}
	float3 smoke = alpha > 1e-3 ? acc / alpha : float3(0, 0, 0);
	smoke = GasLight > 0.5 ? GasToSrgb(smoke) : smoke;
	OutColor = float4(lerp(Col.rgb, smoke, aq), Col.a);
}

// The room's light (stage 6): the frame before the gas at 1/32 - a thread a 32x32 tile, every 4th pixel, weighted by
// depth so the gun and the hands (nearer than 50 cm) do not darken the smoke at the muzzle; then a blur each way, the
// second blended into the last frame's (<= 0.1 s) with a floor (a shadow in space is not pure black).
Texture2D AmbientSceneColor;
Texture2D AmbientDepth;
RWTexture2D<float4> AmbientOut;
int2 AmbientSize;

[numthreads(8, 8, 1)]
void AmbientDownCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= AmbientSize))
	{
		return;
	}
	float3 Sum = 0;
	float W = 0;
	for (int y = 2; y < 32; y += 4)
	{
		for (int x = 2; x < 32; x += 4)
		{
			int2 P = min(OutMin + int2(Id.xy) * 32 + int2(x, y), OutMin + OutSize - 1);
			float2 DepthPx = DepthMin + (P - OutMin) * DepthScale;
			float DeviceZ = AmbientDepth.Load(int3(DepthPx, 0)).r;
			float Depth = DeviceZ <= 0.0 ? 1e7 : ConvertFromDeviceZ(DeviceZ);
			float w = smoothstep(40.0, 60.0, Depth);
			Sum += AmbientSceneColor.Load(int3(P, 0)).rgb * w;
			W += w;
		}
	}
	AmbientOut[Id.xy] = float4(W > 0.0 ? Sum / W : 0.0, W / 64.0);
}

Texture2D<float4> AmbientIn;
Texture2D<float4> AmbientHistory;
int2 AmbientDir;
float AmbientBlend;
float AmbientFloor;
float AmbientHasHistory;

[numthreads(8, 8, 1)]
void AmbientBlurCS(uint3 Id : SV_DispatchThreadID)
{
	if (any(int2(Id.xy) >= AmbientSize))
	{
		return;
	}
	static const float K[5] = { 0.0625, 0.25, 0.375, 0.25, 0.0625 };
	float3 Sum = 0;
	float W = 0;
	for (int i = -2; i <= 2; i++)
	{
		int2 P = clamp(int2(Id.xy) + AmbientDir * i * 2, 0, AmbientSize - 1);
		float4 S = AmbientIn.Load(int3(P, 0));
		Sum += S.rgb * S.a * K[i + 2];
		W += S.a * K[i + 2];
	}
	float3 Now = W > 1e-4 ? Sum / W : 0.0;
	float Valid = saturate(W * 8.0);
	if (AmbientBlend >= 0.0)
	{
		// The second pass: into the last frame's, a texel with nothing behind it (the gun over the tile) keeps the last.
		float3 Last = AmbientHasHistory > 0.5 ? AmbientHistory.Load(int3(Id.xy, 0)).rgb : Now;
		Now = lerp(Last, max(Now, AmbientFloor), AmbientBlend * Valid);
		AmbientOut[Id.xy] = float4(max(Now, AmbientFloor), 1.0);
	}
	else
	{
		AmbientOut[Id.xy] = float4(Now, W);
	}
}

Binaries/
Intermediate/
Saved/
DerivedDataCache/
# written by every cook (RunUAT BuildCookRun)
Build/Windows/FileOpenOrder/
.vs/
*.sln

# ue-mcp.yml is shared; per-machine overrides stay local
ue-mcp.local.*
# The two MCP editor plugins each user deploys locally (README, MCP section)
Plugins/UE_MCP_Bridge/
Plugins/VibeUE/
.idea/
__pycache__/

# Local planning scratchpad; shared tasks live on the board (Docs/Workflow.md).
/Docs/Planning/MVP-Backlog.md

# Art sources stay out of the repo (LFS quota, Docs/Development.md "Git LFS").
# Commit the exported .fbx/.png into Content/, not the source.
*.blend
*.blend1
*.psd
*.psb
*.spp
*.kra
*.xcf
*.ztl
*.zpr
*.max
*.ma
*.mb

# ArtSource/ holds the art sources (renders, exports, .blend). Only the pipeline
# code and notes there are committed: scripts, shaders, configs, docs.
/ArtSource/**
!/ArtSource/**/
!/ArtSource/**/*.py
!/ArtSource/**/*.md
!/ArtSource/**/*.json
!/ArtSource/**/*.yaml
!/ArtSource/**/*.txt
!/ArtSource/**/*.usf
!/ArtSource/**/*.ush
!/ArtSource/**/*.js
!/ArtSource/**/*.html
!/ArtSource/**/*.svg
!/ArtSource/**/.gitignore

# Local art-direction and visual iteration workspace
.dream-loop/
